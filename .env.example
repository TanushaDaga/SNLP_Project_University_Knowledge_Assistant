# Copy this file to ".env" and put your own Groq key there (https://console.groq.com). Never commit ".env".
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# ANSWER_STYLE=adaptive        # adaptive | detailed | concise
# USE_LLM=1                    # 0 = extractive answers only, no API calls
